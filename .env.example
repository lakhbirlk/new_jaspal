# Copy to .env and change the secrets before running `docker compose up`.
# The values below are development defaults; do not reuse them in production.

APP_PORT=8080

# PostgreSQL container
DB_NAME=directory
DB_USER=directory
DB_PASSWORD=directory

# Application secrets. JWT_SECRET must be at least 32 bytes.
# Generate values with: openssl rand -base64 48
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789-abcdefghijklmnopqrstuvwxyz
# Base64-encoded 32-byte key: openssl rand -base64 32
APP_CRYPTO_KEY=ZGV2LW9ubHktY3J5cHRvLWtleS1jaGFuZ2UtbWUtMzJieXRlcw==

# Bootstrapped administrator (created on first start, password hashed with Argon2)
ADMIN_EMAIL=admin@directory.local
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Platform Administrator

# Public URL used in verification, reset and invitation emails.
FRONTEND_URL=http://localhost:8080
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8080

# Outbound email. Leave SMTP_HOST empty to log and skip delivery.
MAIL_FROM=no-reply@directory.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Payment provider webhook signing secret.
PAYMENT_WEBHOOK_SECRET=
