# Copy to terraform.tfvars and adjust.
aws_region    = "us-east-1"
name          = "business-directory"
environment   = "demo"
instance_type = "t4g.small"

# Public repository cloned and built on first boot.
git_repo_url = "https://github.com/lakhbirlk/new_jaspal.git"
git_branch   = "main"

# Leave empty to disable SSH; use `aws ssm start-session` instead.
ssh_cidr = ""

admin_email = "admin@example.com"
seed_demo   = true

# Leave empty to use the free <ip-with-dashes>.sslip.io hostname. Set your own
# name (with an A record pointing at the Elastic IP) to use a real domain.
https_domain = ""
tls_email    = "admin@example.com"
